# ── Veritabanı ───────────────────────────────────────────────────────────────
# PostgreSQL bağlantı adresi (Neon, Supabase, Railway, Render veya kendi sunucunuz).
DATABASE_URL=postgres://kullanici:sifre@sunucu:5432/veritabani

# Bulut veritabanlarında SSL gerekir ("true"). Yerel kurulumda "false" yapın.
DATABASE_SSL=true

# ── Platform sahibi ──────────────────────────────────────────────────────────
# Ofisleri açan hesap. Uygulama ilk açıldığında bir kez oluşturulur.
# Şifre en az 12 karakter olmalı, harf ve rakam içermeli.
PLATFORM_ADMIN_EMAIL=siz@ornek.com
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME=Platform Yöneticisi

# ── İsteğe bağlı ─────────────────────────────────────────────────────────────
# docker-compose.yml için veritabanı şifresi.
POSTGRES_PASSWORD=

# Açılıştaki otomatik veritabanı kurulumunu kapatmak için "false"
# (o durumda `npm run setup` komutunu elle çalıştırın).
# AUTO_MIGRATE=true

# Uygulama HTTPS olmadan (yalnızca yerel deneme) çalışacaksa "false".
# COOKIE_SECURE=true
