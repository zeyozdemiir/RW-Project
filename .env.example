# PostgreSQL bağlantı adresi (Neon, Supabase, Railway veya kendi sunucunuz)
DATABASE_URL=postgres://kullanici:sifre@sunucu:5432/veritabani

# Yönetilen (bulut) veritabanlarında SSL gerekir. Yerel kurulumda "false" yapın.
DATABASE_SSL=true

# Platform sahibi (ofisleri oluşturan hesap). `npm run setup` ile bir kez oluşturulur.
PLATFORM_ADMIN_EMAIL=siz@ornek.com
PLATFORM_ADMIN_PASSWORD=en-az-12-karakterli-guclu-bir-sifre
PLATFORM_ADMIN_NAME=Platform Yöneticisi
